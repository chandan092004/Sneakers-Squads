{
  "version": 2,
  "builds": [
    {
      "src": "sneakerweb/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "includeFiles": ["db.sqlite3", "templates/**", "static/**", "media/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "sneakerweb/wsgi.py"
    }
  ]
}
